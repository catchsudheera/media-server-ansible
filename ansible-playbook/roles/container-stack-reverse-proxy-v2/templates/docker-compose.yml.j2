services:
  npm:
    container_name: npm
    image: 'jc21/nginx-proxy-manager:latest'
    restart: unless-stopped
    ports:
      - '80:80'
      - '443:443'
      - '81:81'
    environment:
      - DB_POSTGRES_HOST=db
      - DB_POSTGRES_PORT=5432
      - DB_POSTGRES_USER={{ database_username }}
      - DB_POSTGRES_PASSWORD={{ database_password }}
      - DB_POSTGRES_NAME=npm
      - PUID={{ server_data_user_uid }}
      - PGID={{ server_data_group_gid }}
      - TZ={{ server_timezone }}
    volumes:
      - {{ nginx_proxy_manager_config_path }}:/data
      - {{ nginx_proxy_manager_lets_encrypt_path }}:/etc/letsencrypt
    depends_on:
      - npm_db
    networks:
      - media_server_network
  npm_db:
    container_name: postgres
    image: postgres:latest
    restart: unless-stopped
    environment:
      - PUID={{ server_data_user_uid }}
      - PGID={{ server_data_group_gid }}
      - TZ={{ server_timezone }}
      - POSTGRES_USER={{ database_username }}
      - POSTGRES_PASSWORD={{ database_password }}
      - POSTGRES_DB=npm
    volumes:
      - {{ nginx_proxy_manager_database_path }}:/var/lib/postgresql/data
    networks:
      - media_server_network
  homepage:
    image: ghcr.io/gethomepage/homepage:latest
    container_name: homepage
    environment:
      - HOMEPAGE_ALLOWED_HOSTS=gethomepage.dev
      - PUID={{ server_data_user_uid }}
      - PGID={{ server_data_group_gid }}
    ports:
      - 3000:3000
    volumes:
      - {{ homepage_proxy_manager_config_path }}:/app/config
      - /var/run/docker.sock:/var/run/docker.sock:ro
    restart: unless-stopped
    networks:
      - media_server_network

networks:
  media_server_network:
    external:
      name: {{ docker_bridge_network_name }}