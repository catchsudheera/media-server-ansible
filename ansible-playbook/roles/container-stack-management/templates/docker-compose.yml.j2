version: "3.8"

services:
  dockhand-hawser:
    image: fnsys/hawser:latest
    container_name: dockhand-hawser
    environment:
      - DOCKHAND_SERVER_URL={{ dockhand_server_url }}
      - TOKEN={{ dockhand_server_token }}
      - AGENT_NAME={{ dockhand_agent_name }}
      - SKIP_DF_COLLECTION=false
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - {{ dockhand_hawser_config_path }}:/data/stacks
    networks:
      - media_server_network
    restart: always
networks:
  media_server_network:
    external:
      name: {{ docker_bridge_network_name }}